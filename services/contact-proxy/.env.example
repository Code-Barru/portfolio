# ntfy server URL (defaults to http://ntfy — the Docker service name)
NTFY_URL=http://ntfy

# ntfy topic to publish to
NTFY_TOPIC=contact-portfolio

# Port the proxy listens on (inside the container)
LISTEN_PORT=8000

# Rate-limiting: max requests per IP within the time window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60
