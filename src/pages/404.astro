---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import { useT } from '../i18n';

const t = useT('en');
---

<BaseLayout locale="en">
	<Fragment slot="head">
		<SEO
			title={t('error_404_title')}
			description={t('error_404_description')}
			path="/404"
			locale="en"
			noindex
		/>
	</Fragment>

	<div class="py-8">
		<h1 class="mb-4 text-4xl font-bold text-mocha-red">{t('error_404_title')}</h1>
		<p class="mb-6 text-mocha-subtext1">{t('error_404_description')}</p>
		<a href="/" class="text-mocha-blue hover:underline">{t('error_back_home')}</a>
	</div>
</BaseLayout>
