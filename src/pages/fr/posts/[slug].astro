---
import PostSlugPage from '../../../page-templates/PostSlugPage.astro';
import { getPosts } from '../../../lib/collections';

export async function getStaticPaths() {
	const posts = await getPosts('fr');
	return posts.map((post, i) => ({
		params: { slug: post.slug },
		props: {
			post,
			prev: posts[i - 1] ?? null,
			next: posts[i + 1] ?? null
		}
	}));
}
---

<PostSlugPage locale="fr" {...Astro.props} />
