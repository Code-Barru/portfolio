    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "paint": {
        "fill-color": "#74c7ec",
        "fill-opacity": 0.3
      }
    },
    {
      "id": "physical_line_stream",
      "type": "line",
      "source": "protomaps",
      "source-layer": "physical_line",
      "filter": ["==", ["get", "pmap:kind"], "river"],
      "paint": {
        "line-color": "#74c7ec",
        "line-width": 0.5,
        "line-opacity": 0.4
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "buildings",
      "paint": {
        "fill-color": "#313244",
        "fill-opacity": {
          "stops": [
            [12, 0],
            [14, 0.5],
            [16, 0.8]
          ]
        }
      }
    },
    {
      "id": "buildings_outline",
      "type": "line",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": {
        "line-color": "#45475a",
        "line-width": 0.5,
        "line-opacity": 0.5
      }
    },
    {
      "id": "roads_tunnels_other_casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": [
        "all",
        ["<", ["get", "pmap:level"], 0],
        ["==", ["get", "pmap:kind"], "other"]
      ],
      "paint": {
        "line-color": "#11111b",
        "line-gap-width": [
          "interpolate",
          ["exponential", 1.6],
          ["zoom"],
          14,
          0,
          20,
          7
        ]
