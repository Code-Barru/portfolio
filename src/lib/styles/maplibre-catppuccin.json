{
  "version": 8,
  "name": "Catppuccin Mocha",
  "sources": {
    "protomaps": {
      "type": "vector",
      "tiles": ["https://api.protomaps.com/tiles/v3/{z}/{x}/{y}.mvt"],
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>",
      "maxzoom": 14
    }
  },
  "glyphs": "https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#1e1e2e"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#1e1e2e"
      }
    },
    {
      "id": "landuse_park",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["==", ["get", "pmap:kind"], "park"],
      "paint": {
        "fill-color": "#a6e3a1",
        "fill-opacity": 0.15
      }
    },
    {
      "id": "landuse_forest",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["==", ["get", "pmap:kind"], "forest"],
      "paint": {
        "fill-color": "#a6e3a1",
        "fill-opacity": 0.2
      }
    },
    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["==", ["get", "pmap:kind"], "residential"],
      "paint": {
        "fill-color": "#181825",
        "fill-opacity": 0.5
