      "filter": ["==", ["get", "pmap:kind"], "neighbourhood"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-max-width": 7,
        "text-size": {
          "stops": [
            [10, 8],
            [12, 10]
