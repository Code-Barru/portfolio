{
  "version": 8,
  "name": "Catppuccin Mocha (Maptiler)",
  "sources": {
    "maptiler": {
      "type": "vector",
      "url": "https://api.maptiler.com/tiles/v3/tiles.json?key=USE_KEY_PARAMETER"
    }
  },
  "glyphs": "https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key=USE_KEY_PARAMETER",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#1e1e2e"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "maptiler",
      "source-layer": "water",
      "paint": {
        "fill-color": "#74c7ec",
        "fill-opacity": 0.3
      }
    },
    {
      "id": "landcover_grass",
      "type": "fill",
      "source": "maptiler",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": {
        "fill-color": "#a6e3a1",
        "fill-opacity": 0.1
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "maptiler",
      "source-layer": "park",
      "paint": {
        "fill-color": "#a6e3a1",
        "fill-opacity": 0.15
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "maptiler",
      "source-layer": "building",
      "paint": {
        "fill-color": "#313244",
        "fill-opacity": {
          "stops": [[14, 0], [15, 0.5], [16, 0.8]]
        },
        "fill-outline-color": "#45475a"
      }
    },
    {
      "id": "road_path",
      "type": "line",
      "source": "maptiler",
      "source-layer": "transportation",
      "filter": ["==", "class", "path"],
      "paint": {
        "line-color": "#45475a",
        "line-width": 1
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "maptiler",
      "source-layer": "transportation",
      "filter": ["==", "class", "minor"],
      "paint": {
        "line-color": "#45475a",
        "line-width": {
          "stops": [[12, 1], [14, 2], [16, 3]]
        }
      }
    },
    {
      "id": "road_secondary",
      "type": "line",
      "source": "maptiler",
      "source-layer": "transportation",
      "filter": ["==", "class", "secondary"],
      "paint": {
        "line-color": "#585b70",
        "line-width": {
          "stops": [[10, 1], [14, 3], [16, 5]]
        }
      }
    },
    {
      "id": "road_primary",
      "type": "line",
      "source": "maptiler",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#585b70",
        "line-width": {
          "stops": [[8, 1], [12, 3], [16, 6]]
        }
      }
    },
    {
      "id": "road_trunk",
      "type": "line",
      "source": "maptiler",
      "source-layer": "transportation",
      "filter": ["==", "class", "trunk"],
      "paint": {
        "line-color": "#585b70",
        "line-width": {
          "stops": [[6, 1], [12, 4], [16, 8]]
        }
      }
    },
    {
      "id": "road_motorway",
      "type": "line",
      "source": "maptiler",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#585b70",
        "line-width": {
          "stops": [[4, 1], [10, 3], [16, 10]]
        }
      }
    },
    {
      "id": "boundary_country",
      "type": "line",
      "source": "maptiler",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 2],
      "paint": {
        "line-color": "#9399b2",
        "line-width": 1,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "place_label_city",
      "type": "symbol",
      "source": "maptiler",
      "source-layer": "place",
      "filter": ["==", "class", "city"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "stops": [[4, 10], [8, 14], [12, 18]]
        }
      },
      "paint": {
        "text-color": "#89b4fa",
        "text-halo-color": "#1e1e2e",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place_label_town",
      "type": "symbol",
      "source": "maptiler",
      "source-layer": "place",
      "filter": ["==", "class", "town"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "stops": [[8, 8], [12, 12]]
        }
      },
      "paint": {
        "text-color": "#cdd6f4",
        "text-halo-color": "#1e1e2e",
        "text-halo-width": 1
      }
    },
    {
      "id": "road_label",
      "type": "symbol",
      "source": "maptiler",
      "source-layer": "transportation_name",
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "stops": [[12, 9], [16, 12]]
        }
      },
      "paint": {
        "text-color": "#89b4fa",
        "text-halo-color": "#1e1e2e",
        "text-halo-width": 1.5
      },
      "minzoom": 12
    }
  ]
}
