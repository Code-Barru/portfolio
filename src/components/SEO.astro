---
import { localizePath, ogLocale, type Locale } from '../i18n';

interface Props {
	title: string;
	description: string;
	/** Locale-less path, e.g. '/posts/shellcode'. */
	path: string;
	locale: Locale;
	type?: 'website' | 'article';
	image?: string;
	publishedTime?: Date;
	tags?: string[];
	noindex?: boolean;
}

const {
	title,
	description,
	path,
	locale,
	type = 'website',
	image = '/og-default.png',
	publishedTime,
	tags = [],
	noindex = false
} = Astro.props;

const site = Astro.site!.href.replace(/\/$/, '');
const canonical = site + localizePath(path, locale);
const imageUrl = image.startsWith('http') ? image : site + image;
const alternateLocale: Locale = locale === 'fr' ? 'en' : 'fr';
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

<link rel="canonical" href={canonical} />

<meta property="og:site_name" content="Antoine Ousselin" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale(locale)} />
<meta property="og:locale:alternate" content={ogLocale(alternateLocale)} />
<meta property="og:image" content={imageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{
	type === 'article' && publishedTime && (
		<meta property="article:published_time" content={publishedTime.toISOString()} />
	)
}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<link rel="alternate" hreflang="en" href={site + localizePath(path, 'en')} />
<link rel="alternate" hreflang="fr" href={site + localizePath(path, 'fr')} />
<link rel="alternate" hreflang="x-default" href={site + localizePath(path, 'en')} />

<link
	rel="alternate"
	type="application/rss+xml"
	title="Antoine Ousselin — Blog"
	href={site + localizePath('/rss.xml', locale)}
/>
