---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import { useT, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
---

<BaseLayout {locale}>
	<Fragment slot="head">
		<SEO
			title={t('seo_privacy_title')}
			description={t('seo_privacy_description')}
			path="/privacy"
			{locale}
		/>
	</Fragment>

	<div class="py-8">
		<h1 class="mb-4 text-3xl font-bold text-mocha-blue md:mb-8 md:text-4xl">
			{t('privacy_title')}
		</h1>

		<div class="mb-4 md:mb-8">
			<div class="mb-2 text-xl text-mocha-blue md:text-2xl">{t('privacy_section1_title')}</div>
			<div class="text-sm text-mocha-subtext0 md:text-base">
				{t('privacy_section1_content')}
			</div>
		</div>

		<div class="mb-4 md:mb-8">
			<div class="mb-2 text-xl text-mocha-blue md:text-2xl">{t('privacy_section2_title')}</div>
			<div class="mb-3 text-sm text-mocha-subtext0 md:text-base">
				{t('privacy_section2_intro')}
			</div>
			<ul class="ml-5 list-disc space-y-1 text-sm text-mocha-text md:text-base">
				<li>{t('privacy_section2_page')}</li>
				<li>{t('privacy_section2_device')}</li>
				<li>{t('privacy_section2_location')}</li>
				<li>{t('privacy_section2_language')}</li>
			</ul>
			<div class="mt-3 text-sm font-semibold text-mocha-text md:text-base">
				{t('privacy_section2_not_collected')}
			</div>
		</div>

		<div class="mb-4 md:mb-8">
			<div class="mb-2 text-xl text-mocha-blue md:text-2xl">{t('privacy_section3_title')}</div>
			<div class="text-sm text-mocha-subtext0 md:text-base">
				{t('privacy_section3_content')}
			</div>
		</div>
	</div>
</BaseLayout>
