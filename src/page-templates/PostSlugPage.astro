---
import { render } from 'astro:content';
import { Calendar, Clock, Tag as TagIcon, ArrowLeft } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import TableOfContents from '../components/islands/TableOfContents.svelte';
import { localizePath, useT, type Locale } from '../i18n';
import type { PostItem } from '../lib/collections';

interface Props {
	locale: Locale;
	post: PostItem;
	prev: PostItem | null;
	next: PostItem | null;
}

const { locale, post, prev, next } = Astro.props;
const t = useT(locale);
const { Content } = await render(post.entry);

const formatDate = (date: Date) =>
	date.toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric'
	});

const postsPath = localizePath('/posts', locale);
const site = Astro.site!.href.replace(/\/$/, '');

const jsonLd = [
	{
		'@type': 'BlogPosting',
		headline: post.title,
		description: post.description,
		datePublished: post.date.toISOString().split('T')[0],
		inLanguage: locale,
		keywords: post.tags.join(', '),
		mainEntityOfPage: site + localizePath(`/posts/${post.slug}`, locale),
		author: { '@type': 'Person', name: 'Antoine Ousselin', url: site }
	},
	{
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: site + localizePath('/', locale) },
			{ '@type': 'ListItem', position: 2, name: 'Blog', item: site + postsPath },
			{
				'@type': 'ListItem',
				position: 3,
				name: post.title,
				item: site + localizePath(`/posts/${post.slug}`, locale)
			}
		]
	}
];
---

<BaseLayout {locale}>
	<Fragment slot="head">
		<SEO
			title={post.title}
			description={post.description}
			path={`/posts/${post.slug}`}
			{locale}
			type="article"
			publishedTime={post.date}
			tags={post.tags}
			image={post.coverImage}
		/>
		<JsonLd schema={jsonLd} />
	</Fragment>

	<div class="relative py-8">
		<TableOfContents client:idle title={t('toc_title')} />

		<div class="mx-auto max-w-3xl">
			<a
				href={postsPath}
				class="mb-6 inline-flex items-center gap-2 text-mocha-blue transition-colors hover:text-mocha-sapphire"
			>
				<ArrowLeft size={18} />
				Back to posts
			</a>

			<article>
				<header class="mb-8">
					<h1 class="mb-4 text-4xl font-bold text-mocha-text md:text-5xl">
						{post.title}
					</h1>

					<div class="mb-4 flex flex-wrap items-center gap-4 text-sm text-mocha-subtext0">
						<span class="flex items-center gap-1">
							<Calendar size={16} />
							{formatDate(post.date)}
						</span>

						{
							post.readingTime > 0 && (
								<span class="flex items-center gap-1">
									<Clock size={16} />
									{post.readingTime} min read
								</span>
							)
						}
					</div>

					{
						post.tags.length > 0 && (
							<div class="mb-4 flex flex-wrap gap-2">
								<TagIcon size={16} class="mt-1 text-mocha-subtext0" />
								{post.tags.map((tag) => (
									<a
										href={`${postsPath}?tags=${tag}`}
										class="rounded-full border border-mocha-surface1 border-t-mocha-surface2 bg-mocha-base px-3 py-1 text-sm text-mocha-text shadow-sm shadow-mocha-crust transition-colors duration-200 hover:border-mocha-blue active:bg-mocha-surface0"
									>
										{tag}
									</a>
								))}
							</div>
						)
					}

					{
						post.coverImage && (
							<img
								src={post.coverImage}
								alt={post.title}
								loading="lazy"
								width="800"
								height="400"
								class="mb-6 h-64 w-full rounded-lg object-cover"
							/>
						)
					}
				</header>

				<div class="markdown-content mt-8 rounded-lg bg-mocha-crust p-6 md:p-8">
					<Content />
				</div>
			</article>

			<nav class="mt-12 flex justify-between border-t border-mocha-surface1 pt-8">
				{
					prev ? (
						<a
							href={localizePath(`/posts/${prev.slug}`, locale)}
							class="group flex max-w-[45%] flex-col gap-1 text-left transition-colors"
						>
							<span class="text-xs text-mocha-subtext0">← Previous</span>
							<span class="text-sm font-semibold text-mocha-text transition-colors group-hover:text-mocha-blue">
								{prev.title}
							</span>
						</a>
					) : (
						<div />
					)
				}

				{
					next && (
						<a
							href={localizePath(`/posts/${next.slug}`, locale)}
							class="group flex max-w-[45%] flex-col gap-1 text-right transition-colors"
						>
							<span class="text-xs text-mocha-subtext0">Next →</span>
							<span class="text-sm font-semibold text-mocha-text transition-colors group-hover:text-mocha-blue">
								{next.title}
							</span>
						</a>
					)
				}
			</nav>

			<div class="mt-8 border-t border-mocha-surface1 pt-6">
				<a
					href={postsPath}
					class="inline-flex items-center gap-2 text-mocha-blue transition-colors hover:text-mocha-sapphire"
				>
					<ArrowLeft size={18} />
					Back to all posts
				</a>
			</div>
		</div>
	</div>
</BaseLayout>
