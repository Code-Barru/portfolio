---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import PostsExplorer from '../components/islands/PostsExplorer.svelte';
import { getPosts, extractTags, toPostMeta } from '../lib/collections';
import { useT, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);

const posts = (await getPosts(locale)).map(toPostMeta);
const tags = extractTags(posts);

const labels = {
	search: t('blog_search'),
	filterByTags: t('blog_filter_by_tags'),
	found: t('blog_found'),
	foundPlural: t('blog_found_plural')
};
---

<BaseLayout {locale}>
	<Fragment slot="head">
		<SEO
			title={t('seo_blog_title')}
			description={t('seo_blog_description')}
			path="/posts"
			{locale}
		/>
	</Fragment>

	<div class="py-8">
		<h1 class="mb-8 text-4xl font-bold text-mocha-blue">{t('blog_name')}</h1>
		<PostsExplorer client:load {posts} {tags} {locale} {labels} />
	</div>
</BaseLayout>
